{
  "name": "expo-play-games-kit",
  "version": "0.2.2",
  "description": "Cross-platform game services for Expo: Google Play Games Services v2 (Android) + Game Center (iOS). Auth, achievements, and the Google Play Level Up compliance surface (Game Stats, Recall).",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "expo-config-plugin",
    "google-play-games",
    "play-games-services",
    "play-games-services-v2",
    "game-center",
    "gamekit",
    "achievements",
    "game-stats",
    "recall-api",
    "play-level-up"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsidianart/expo-play-games-kit.git"
  },
  "bugs": {
    "url": "https://github.com/obsidianart/expo-play-games-kit/issues"
  },
  "author": "Stefano Solinas <imagzle@obsidianart.com> (https://github.com/obsidianart)",
  "license": "MIT",
  "homepage": "https://github.com/obsidianart/expo-play-games-kit#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.1",
    "babel-preset-expo": "~55.0.8",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.17",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.9",
    "prettier": "^3.0.0",
    "react-native": "0.82.1",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
